// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Customer  {
  id          String   @id @default(cuid(2))
  
  name        String
  email       String   @unique
  number      String   @unique
  verified    Boolean  @default(false)
  
  orders      Order[]
  payments    Payment[]
  addresses   Address[]

  createdAt   DateTime @default(now())
}

model Admin{
  id           String     @id @default(cuid(2))

  password     String     
  name         String
  loginAttempt Int        @default(0)
  loginTime    DateTime   @default(now())

  createdAt    DateTime   @default(now())
}

model Banner{
  id        String      @id @default(cuid(2))
  
  title     String
  subtitle  String
  image     String
  link      String
  
  createdAt DateTime @default(now())
}

model Settings{
  id        String      @id @default(cuid(2))
  number    String
  name      String
  email     String
  
  gstNumber String
  whatsapp  String
  address   String

  upiId        String
  upiName      String
  merchantName String

  shippingCharge   Decimal @db.Decimal(10, 2)

  createdAt        DateTime @default(now())
}

model Product {
  id              String      @id @default(cuid(2))
  title           String
  slug            String   @unique
  sku             String   @unique
  price           Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal  @db.Decimal(10, 2)
  description     String
  pattern         String

  isPublished     Boolean  @default(false)
  
  color           ProductVariant[]
  images          ProductImages[]
  tags            Tag[]
  orders          OrderItem[]
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  featured        Boolean  @default(false)
  width           Int      @default(0)
  washCare        String   @default("")
  rating          Float    @default(0)
  reviews         Int      @default(0)

  seoTitle        String   @default("")
  seoDescription  String   @default("")

  deletedAt       DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@index([categoryId])
  @@index([isPublished])
  @@index([price])
  @@index([originalPrice])
  @@index([featured])
  @@index([title])
}

model ProductVariant {
  id              String   @id @default(cuid(2))   
  availableMeters Decimal  @db.Decimal(10, 2)
  lowStockAlert   Decimal  @db.Decimal(10, 2)

  isLowStock      Boolean  @default(false)

  name            String
  hex             String   
  productId       String

  product         Product  @relation(fields : [productId] , references: [id]) 
  
  @@index([productId])
  @@index([isLowStock])
  @@index([availableMeters])
}

model ProductImages {
  id            String           @id @default(cuid(2))
  publicId      String           
  url           String
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  
  displayOrder  Int              @default(0)
  
  orderItem     OrderItem[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productId, publicId])
}

model StrandedImages {
  id            String           @id @default(cuid(2))
  publicId      String           
  url           String

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([publicId])
}

model Category {
    id            String      @id @default(cuid(2))
    name          String      @unique

    products      Product[]
}

model Tag {
  id       String      @id @default(cuid(2))

  name     String      @unique
  slug     String?     @unique

  products Product[]
}

enum Status {
  Pending
  Confirmed
  Packed
  Shipped
  Delivered
  Cancelled
}


model Order {
  id              String            @id @default(cuid(2))
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  payment         Payment?

  subtotal        Decimal           @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  status          Status            @default(Pending)

  addressId       String      
  address         Address           @relation(fields: [addressId], references: [id])

  shipping        Decimal           @db.Decimal(10, 2)

  notes           String?

  orderItems      OrderItem[]

  expireAt        DateTime          @default(dbgenerated("(( NOW() + '300 seconds' ::INTERVAL))")) 
  reverseAt       DateTime          @default(dbgenerated("(( NOW() + '330 seconds' ::INTERVAL))"))

  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum Method {
  COD
  UPI
}

model Payment {
  id            String        @id @default(cuid(2))
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(Pending) 
  method        Method
  reference     String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  number        String?
  
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())
}

model Address {
  id         String        @id @default(cuid(2))
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  
  order      Order[]

  address    String
  city       String
  state      String
  pincode    String
  area       String
  landmark   String?

  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())
}

model OrderItem {
  id              String   @id @default(cuid(2))
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  

  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  title           String
  price           Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal  @db.Decimal(10, 2)
  
  
  imageId         String
  image           ProductImages @relation(fields: [imageId], references: [id])

  color           Json     @db.JsonB   

  pattern         String   @default("")
  width           Int     
  categoryName    String

  @@index([productId])
  @@index([orderId])
} 

